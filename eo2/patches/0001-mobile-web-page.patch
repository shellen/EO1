+      var s2 = tx.s2 ? makeText(f2.lines, '400', f2.s, css(ink, 0.66), { lh: f2.s * 1.25 }) : null;
+      var bh = 30 + 16 + 18 + hero.th + 18 + s1.th + (s2 ? 8 + s2.th : 0) + 34;
+      var band = mk(W, bh), bx = band.x, y = 30;
+      bx.fillStyle = css(pal.bg); bx.fillRect(0, 0, W, bh);
+      bx.fillStyle = css(pal.accent); bx.fillRect(0, 0, W, 6);
+      blit(bx, label, PX - label.pad, y - label.pad);
+      if (date) { blit(bx, date, W - PX - date.tw - date.pad, y + 1 - date.pad); }
+      y += 16 + 18;
+      blit(bx, hero, PX - hero.pad, y - hero.pad);
+      y += hero.th + 18;
+      blit(bx, s1, PX - s1.pad, y - s1.pad);
+      y += s1.th;
+      if (s2) { y += 8; blit(bx, s2, PX - s2.pad, y - s2.pad); }
+      v.band = band; v.bh = bh; v.bandY = 916 - bh; v.pal = pal;
+      var top = 52, bottom = v.bandY - 34;
+      v.cs = Math.round(clamp(Math.min(344, bottom - top), 150, 344));
+      v.ccy = top + (bottom - top) / 2;
+      v.card = makeCover(sc.art, v.cs);
+      v.card.x.strokeStyle = 'rgba(255,255,255,0.35)';
+      v.card.x.lineWidth = 1.5;
+      v.card.x.strokeRect(0.75, 0.75, v.cs - 1.5, v.cs - 1.5);
+      var D = v.cs + 160;
+      v.shadow = mk(D, D);
+      var sx = v.shadow.x;
+      sx.shadowColor = 'rgba(0,0,0,0.75)';
+      sx.shadowBlur = 44 * S;
+      sx.shadowOffsetX = 3000 * S;
+      sx.fillStyle = '#000';
+      sx.fillRect(80 - 3000, 80, v.cs, v.cs);
+      v.target = { x: CELL * (0.5 + (hashStr(sc.key) % 4)), y: 70 + (hashStr(sc.key + 'y') % 3) * CELL };
+      return v;
+    }
+
+    function drawCard(ctx, v, cx, cy, size, a, rot) {
+      if (a <= 0.01) { return; }
+      var k = size / v.cs, h = size / 2;
+      ctx.globalAlpha = a * 0.95;
+      ctx.drawImage(v.shadow, cx - v.shadow.lw * k / 2, cy - v.shadow.lh * k / 2 + 24 * k, v.shadow.lw * k, v.shadow.lh * k);
+      ctx.globalAlpha = a;
+      ctx.save();
+      ctx.translate(cx, cy);
+      ctx.rotate(rot);
+      ctx.drawImage(v.card, -h, -h, size, size);
+      var gx = Math.sin(clock * 0.29) * h;
+      var g = ctx.createLinearGradient(-h + gx, -h, h + gx, h);
+      g.addColorStop(0, 'rgba(255,255,255,0.14)');
+      g.addColorStop(0.5, 'rgba(255,255,255,0)');
+      g.addColorStop(1, 'rgba(0,0,0,0.14)');
+      ctx.fillStyle = g;
+      ctx.fillRect(-h, -h, size, size);
+      ctx.restore();
+      ctx.globalAlpha = 1;
+    }
+
+    function drawBand(ctx, v, x0, x1) {
+      if (v.idle || x1 <= x0) { return; }
+      ctx.save();
+      ctx.beginPath(); ctx.rect(x0, v.bandY - 2, x1 - x0, v.bh + 4); ctx.clip();
+      blit(ctx, v.band, 0, v.bandY);
+      var pr = progressOf(v.sc);
+      if (pr) {
+        ctx.fillStyle = css(v.pal.ink, 0.16);
+        ctx.fillRect(30, v.bandY + v.bh - 16, W - 60, 3);
+        ctx.fillStyle = css(v.pal.accent);
+        ctx.fillRect(30, v.bandY + v.bh - 16, (W - 60) * pr.p, 3);
+      }
+      ctx.restore();
+    }
+
+    return {
+      setScene: function (sc, old) {
+        prev = cur;
+        cur = build(sc);
+        tc = Tn;
+        if (prev && prev.idle) { prev = null; }
+        builtVer = -1;
+      },
+      refresh: function () { if (cur) { cur = build(cur.sc); } },
+      frame: function (ctx, T, dt) {
+        Tn = T;
+        if (!cur) { return; }
+        var playing = !cur.idle && cur.sc.mode === 'playing';
+        speed += ((playing ? 1 : (cur.idle ? 0.45 : 0.35)) - speed) * Math.min(1, dt * 0.03);
+        clock += dt / 60 * speed;
+        var c;
+        for (c = 0; c < COLS; c++) { offs[c] += SPD[c] * speed * dt / 60; }
+        if (builtVer !== recentVer && (T - lastBuild > 1.2 || !wall)) { buildWall(); }
+        if (clock > nextFlip) { scheduleFlip(); nextFlip = clock + 0.9 + rng.next() * 1.6; }
+        /* wall */
+        drawStrips(ctx, wall);
+        if (oldWall) {
+          var wf = clamp01((T - wallFadeT) / 1.4);
+          if (wf >= 1) { oldWall = null; } else {
+            ctx.globalAlpha = 1 - smooth(wf);
+            drawStrips(ctx, oldWall);
+            ctx.globalAlpha = 1;
+          }
+        }
+        drawFlips(ctx);
+        var tt, ta;
+        if (cur.idle) { tt = [6, 8, 12]; ta = 0.6; } else {
+          tt = mix(cur.pal.bg, [0, 0, 0], 0.5); ta = playing ? 0.52 : 0.66;
+        }
+        var kk = Math.min(1, dt * 0.04);
+        tint = mix(tint, tt, kk); tintA += (ta - tintA) * kk;
+        ctx.fillStyle = css(tint, tintA);
+        ctx.fillRect(0, 0, W, H);
+        /* featured card */
+        var fy = Math.sin(clock * 0.5) * 6, rot = Math.sin(clock * 0.33) * 0.012, q, e, r;
+        if (prev) {
+          q = clamp01((T - tc) / 1.2);
+          e = easeInOut(q);
+          drawCard(ctx, prev, W / 2 + (prev.target.x - W / 2) * e, prev.ccy + fy * (1 - e) + (prev.target.y - prev.ccy) * e,
+            prev.cs + (TILE - prev.cs) * e, 1 - smooth((q - 0.55) / 0.45), rot * (1 - e));
+        }
+        if (!cur.idle) {
+          r = clamp01((T - tc - (prev ? 0.5 : 0.1)) / 1.3);
+          e = easeOutCubic(r);
+          var fx0 = CELL * 2.5, fy0 = H - CELL * 0.8;
+          drawCard(ctx, cur, fx0 + (W / 2 - fx0) * e, fy0 + (cur.ccy + fy - fy0) * e, TILE + (cur.cs - TILE) * e, smooth(r / 0.25), rot * e);
+        }
+        /* band wipe */
+        var wp = easeInOut(clamp01((T - tc - 0.25) / 0.9)), wx = W * wp;
+        if (prev) {
+          drawBand(ctx, prev, wx, W);
+          if (wp >= 1 && T - tc > 1.8) { prev = null; }
+        }
+        drawBand(ctx, cur, 0, wx);
+        if (prev && !prev.idle && !cur.idle && wp > 0 && wp < 1) {
+          var by0 = Math.min(prev.bandY, cur.bandY);
+          ctx.fillStyle = css(cur.pal.accent);
+          ctx.fillRect(wx - 6, by0, 6, 916 - by0);
+        }
+        if (cur.idle && cur.connect) {
+          if (!idleShade) {
+            idleShade = mk(W, 220);
+            var ig = idleShade.x.createLinearGradient(0, 0, 0, 220);
+            ig.addColorStop(0, 'rgba(0,0,0,0)'); ig.addColorStop(1, 'rgba(0,0,0,0.78)');
+            idleShade.x.fillStyle = ig; idleShade.x.fillRect(0, 0, W, 220);
+          }
+          blit(ctx, idleShade, 0, H - 220);
+          blit(ctx, cur.connect, (W - cur.connect.lw) / 2, H - 84);
+        }
+      }
+    };
+  }
+
+  /* ================================================================
+     boot
+     ================================================================ */
+
+  var canvas = document.getElementById('music');
+  canvas.width = Math.round(W * S);
+  canvas.height = Math.round(H * S);
+  var ctx = canvas.getContext('2d');
+
+  function fit() {
+    var vw = window.innerWidth || document.documentElement.clientWidth;
+    var vh = window.innerHeight || document.documentElement.clientHeight;
+    var k = Math.max(vw / W, vh / H), w = Math.ceil(W * k), h = Math.ceil(H * k);
+    canvas.style.width = w + 'px';
+    canvas.style.height = h + 'px';
+    canvas.style.left = Math.floor((vw - w) / 2) + 'px';
+    canvas.style.top = Math.floor((vh - h) / 2) + 'px';
+  }
+  fit();
+  window.addEventListener('resize', fit, false);
+
+  style = styleId === 'liquid' ? LiquidStyle() : (styleId === 'wall' ? WallStyle() : KineticStyle());
+  window.MUSIC_CURRENT = { style: styleId, lead: lead };
+  var stats = window.MUSIC_STATS = { style: styleId, frames: 0, totalMs: 0, maxMs: 0, avgMs: 0 };
+
+  wantScene({ key: 'idle:empty', kind: 'empty', mode: 'idle' });
+
+  if (isDemo) {
+    applyState(demoState());
+    setInterval(function () { applyState(demoState()); }, 5000);
+  } else {
+    poll();
+    setInterval(poll, 5000);
+  }
+
+  var textSig = '';
+  setInterval(function () {
+    if (!curScene || curScene.kind !== 'track') { return; }
+    var sig = sceneLabel(curScene) + '|' + dateStr();
+    if (textSig && sig !== textSig) { style.refresh(); }
+    textSig = sig;
+  }, 20000);
+
+  var raf = window.requestAnimationFrame || window.webkitRequestAnimationFrame ||
+    function (cb) { return window.setTimeout(function () { cb(now()); }, 33); };
+  var startT = null, lastT = 0, FRAME_MS = preview ? 1000 / 20 - 2 : 1000 / 30 - 2;
+
+  function tick() {
+    raf(tick);
+    var tnow = now();
+    if (startT === null) { startT = tnow; lastT = tnow - 1000 / 30; }
+    if (tnow - lastT < FRAME_MS) { return; }
+    var dt = Math.min(4, (tnow - lastT) / (1000 / 60));
+    lastT = tnow;
+    var t0 = now();
+    ctx.setTransform(S, 0, 0, S, 0, 0);
+    ctx.globalAlpha = 1;
+    style.frame(ctx, (tnow - startT) / 1000, dt);
+    var ms = now() - t0;
+    stats.frames++;
+    stats.totalMs += ms;
+    stats.avgMs = stats.totalMs / stats.frames;
+    if (ms > stats.maxMs) { stats.maxMs = ms; }
+  }
+  tick();
+})();
+</script>
+</body>
+</html>
diff --git a/app/src/test/java/com/aphex3k/eo1/GeneratedFilesJanitorTest.java b/app/src/test/java/com/aphex3k/eo1/GeneratedFilesJanitorTest.java
new file mode 100644
index 0000000..237a8ec
--- /dev/null
+++ b/app/src/test/java/com/aphex3k/eo1/GeneratedFilesJanitorTest.java
@@ -0,0 +1,103 @@
+package com.aphex3k.eo1;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+
+public class GeneratedFilesJanitorTest {
+
+    @Rule
+    public TemporaryFolder tmp = new TemporaryFolder();
+    private File files;
+    private File up;
+
+    @Before
+    public void setUp() {
+        files = tmp.getRoot();
+        up = new File(files, UploadedMedia.DIR_NAME);
+        assertTrue(up.mkdirs());
+    }
+
+    private File make(File dir, String name, long ageMs) throws IOException {
+        File f = new File(dir, name);
+        FileOutputStream o = new FileOutputStream(f);
+        o.write(new byte[]{1, 2, 3});
+        o.close();
+        assertTrue(f.setLastModified(System.currentTimeMillis() - ageMs));
+        return f;
+    }
+
+    @Test
+    public void keepsOnlyNewestOfEachGeneratedKind() throws IOException {
+        File oldNyt = make(up, "nyt-frontpage-2026-11-19-gif.gif", 3 * 86400000L);
+        File oldNytNote = make(up, "nyt-frontpage-2026-11-19-gif.gif.incompat.txt", 3 * 86400000L);
+        File midNyt = make(up, "nyt-frontpage-2026-11-20-clean.jpg", 2 * 86400000L);
+        File newNyt = make(up, "nyt-frontpage-2026-11-21-gif.gif", 1000);
+        File oldGrid = make(up, "spotify-grid-2026-11-20-12.jpg", 86400000L);
+        File newGrid = make(up, "spotify-grid-2026-11-21-20.gif", 1000);
+        File poster = make(up, "spotify-nowplaying-abc.jpg", 5000);
+        File photo = make(up, "IMG_1.jpg", 9 * 86400000L);
+        File kept = make(up, "art-blocks-1.jpg", 9 * 86400000L);
+
+        assertEquals(4, GeneratedFilesJanitor.run(files));
+        assertFalse(oldNyt.exists());
+        assertFalse(oldNytNote.exists());
+        assertFalse(midNyt.exists());
+        assertTrue(newNyt.exists());
+        assertFalse(oldGrid.exists());
+        assertTrue(newGrid.exists());
+        assertTrue(poster.exists());
+        assertTrue(photo.exists());   // the user's photos are never touched
+        assertTrue(kept.exists());    // nor kept art
+        assertEquals(0, GeneratedFilesJanitor.run(files));   // idempotent
+    }
+
+    @Test
+    public void removesOrphansAndStaleTemp() throws IOException {
+        File orphanNote = make(up, "gone.jpg.incompat.txt", 1000);
+        File photo = make(up, "IMG_2.jpg", 1000);
+        File note = make(up, "IMG_2.jpg.incompat.txt", 1000);
+        File staleTemp = new File(up, "incoming_123");
+        assertTrue(staleTemp.mkdirs());
+        make(staleTemp, "part0", 1000);
+        assertTrue(staleTemp.setLastModified(System.currentTimeMillis() - 2 * 3600000L));
+        File liveTemp = new File(up, "incoming_456");
+        assertTrue(liveTemp.mkdirs());
+
+        File thumbs = new File(files, "thumbs");
+        assertTrue(thumbs.mkdirs());
+        File liveThumb = make(thumbs, WebServer.thumbKey("IMG_2.jpg") + "_abc.jpg", 1000);
+        File deadThumb = make(thumbs, WebServer.thumbKey("deleted.jpg") + "_abc.jpg", 1000);
+
+        GeneratedFilesJanitor.run(files);
+        assertFalse(orphanNote.exists());
+        assertTrue(photo.exists());
+        assertTrue(note.exists());
+        assertFalse(staleTemp.exists());
+        assertTrue(liveTemp.exists());
+        assertTrue(liveThumb.exists());
+        assertFalse(deadThumb.exists());
+    }
+
+    @Test
+    public void trimsTheArtCache() throws IOException {
+        File cache = new File(files, "music-cache");
+        assertTrue(cache.mkdirs());
+        for (int i = 0; i < 75; i++) {
+            make(cache, "a" + i + ".jpg", i * 1000L);
+        }
+        GeneratedFilesJanitor.run(files);
+        assertEquals(60, cache.list().length);
+        assertTrue(new File(cache, "a0.jpg").exists());     // newest kept
+        assertFalse(new File(cache, "a74.jpg").exists());   // oldest gone
+    }
+}
