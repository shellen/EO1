+    jobs.reduce(function(chain, p){
+      return chain.then(function(){ return processAndUpload(p).then(function(){ ok++; }, function(err){ failed++; console.warn(err); }); });
+    }, Promise.resolve()).then(function(){
+      pending = []; refreshFiles();
+      if (failed) toast(ok + " added, " + failed + " failed", 4000);
+      else toast(ok === 1 ? "Added — it’ll appear within a few minutes" : ok + " photos added", 3500);
+    });
+  };
+
+  function loadImage(file){
+    return new Promise(function(res, rej){
+      var url = URL.createObjectURL(file), img = new Image();
+      img.onload = function(){ res({img:img, url:url}); };
+      img.onerror = function(){ URL.revokeObjectURL(url); rej(new Error("Couldn’t read " + file.name)); };
+      img.src = url;
+    });
+  }
+  // Render to exactly 1080x1920 so the frame never has to scale or crop, and so HEIC/large
+  // phone photos arrive as small JPEGs the 2016-era board decodes instantly.
+  function renderForFrame(file){
+    return loadImage(file).then(function(o){
+      var img = o.img, iw = img.naturalWidth, ih = img.naturalHeight;
+      var c = document.createElement("canvas"); c.width = W; c.height = H;
+      var ctx = c.getContext("2d");
+      ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = "high";
+      var cover = Math.max(W / iw, H / ih), contain = Math.min(W / iw, H / ih);
+      if (fit === "whole" && Math.abs(iw / ih - W / H) > 0.02) {
+        ctx.fillStyle = "#000"; ctx.fillRect(0, 0, W, H);
+        ctx.save(); ctx.filter = "blur(40px) brightness(0.55)";
+        ctx.drawImage(img, (W - iw * cover) / 2 - 40, (H - ih * cover) / 2 - 40, iw * cover + 80, ih * cover + 80);
+        ctx.restore();
+        ctx.drawImage(img, (W - iw * contain) / 2, (H - ih * contain) / 2, iw * contain, ih * contain);
+      } else {
+        ctx.drawImage(img, (W - iw * cover) / 2, (H - ih * cover) / 2, iw * cover, ih * cover);
+      }
+      URL.revokeObjectURL(o.url);
+      return new Promise(function(res, rej){
+        c.toBlob(function(b){ b ? res(b) : rej(new Error("Couldn’t convert " + file.name)); }, "image/jpeg", 0.9);
+      });
+    });
+  }
+  function baseName(n){ return (n || "photo").replace(/\.[^.]+$/, "").replace(/[^\w\-]+/g, "_").slice(0, 60) || "photo"; }
+
+  function processAndUpload(p){
+    var f = p.file, label = p.el.querySelector(".vid"), bar = p.el.querySelector(".bar");
+    var isVideo = (f.type || "").indexOf("video/") === 0 || VIDEO.test(f.name);
+    var isGif = /gif$/i.test(f.type) || /\.gif$/i.test(f.name);
+    var prep;
+    if (isVideo || isGif) {
+      prep = Promise.resolve({blob:f, name:f.name || ("clip_" + Date.now() + ".mp4")});
+    } else {
+      prep = renderForFrame(f).then(function(b){
+        var name = baseName(f.name) + "_" + Date.now().toString(36) + ".jpg";
+        var u = URL.createObjectURL(b);
+        p.el.insertAdjacentHTML("afterbegin", '<img src="' + u + '" alt="">');
+        return {blob:b, name:name};
+      });
+    }
+    return prep.then(function(o){
+      label.textContent = "Uploading…";
+      return new Promise(function(res, rej){
+        var fd = new FormData(); fd.append("file", o.blob, o.name);
+        var x = new XMLHttpRequest(); x.open("POST", "/upload");
+        x.upload.onprogress = function(e){ if (e.lengthComputable) bar.style.width = (100 * e.loaded / e.total) + "%"; };
+        x.onload = function(){
+          if (x.status >= 200 && x.status < 300) { bar.style.width = "100%"; label.textContent = ""; res(); }
+          else rej(new Error("Upload failed (" + x.status + ")"));
+        };
+        x.onerror = function(){ rej(new Error("Network error")); };
+        x.send(fd);
+      });
+    }).catch(function(err){ label.textContent = "Failed"; p.el.classList.remove("pending"); throw err; });
+  }
+
+  // ---------- select mode ----------
+  function setSelecting(on){
+    selecting = on; picked = {};
+    document.body.classList.toggle("selecting", on);
+    $("btnSelect").textContent = on ? "Done" : "Select";
+    Array.prototype.forEach.call(document.querySelectorAll(".tile.picked"), function(t){ t.classList.remove("picked"); });
+    renderSelbar();
+  }
+  function renderSelbar(){
+    var n = Object.keys(picked).length;
+    $("selRemove").disabled = n === 0;
+    $("selRemove").textContent = n ? "Remove " + n : "Remove";
+  }
+  $("btnSelect").onclick = function(){ setSelecting(!selecting); };
+  $("selCancel").onclick = function(){ setSelecting(false); };
+  $("selRemove").onclick = function(){
+    var names = Object.keys(picked); if (!names.length) return;
+    if (!confirm("Remove " + names.length + (names.length === 1 ? " photo" : " photos") + " from the frame?")) return;
+    var byName = {}; files.forEach(function(f){ byName[f.name] = f; });
+    names.reduce(function(chain, n){
+      return chain.then(function(){
+        var f = byName[n], jobs = [api(fileUrl(n) + "/delete", {method:"POST"})];
+        if (f && f.warn) jobs.push(api(fileUrl(f.warn) + "/delete", {method:"POST"}).catch(function(){}));
+        return Promise.all(jobs).catch(function(){});
+      });
+    }, Promise.resolve()).then(function(){
+      toast("Removed " + names.length); setSelecting(false); refreshFiles();
+    });
+  };
+
+  // ---------- show now ----------
+  $("sheetShow").onclick = function(){
+    var f = files.filter(function(x){ return x.name === sheetName; })[0];
+    if (!f || !f.assetKey) return;
+    api("/control?action=show&asset=" + encodeURIComponent(f.assetKey)).then(function(j){
+      if (j && j.fired) { toast("Showing it now"); closeSheet(); setTimeout(refreshState, 2500); }
+      else toast("Just added? It can be shown once the frame picks it up — try again in a few minutes.", 4500);
+    }).catch(function(){ toast("Can’t reach the frame"); });
+  };
+
+  // ---------- settings ----------
+  var INTERVALS = [[1,"1 min"],[5,"5 min"],[15,"15 min"],[30,"30 min"],[60,"1 hour"],[180,"3 hours"],[1440,"1 day"]];
+  var settingsDirty = 0;   // ignore polled state for a moment after a save
+  function intervalLabel(m){ return m % 1440 === 0 ? (m / 1440) + (m === 1440 ? " day" : " days") : m % 60 === 0 ? (m / 60) + (m === 60 ? " hour" : " hours") : m + " min"; }
+  function saveSettings(body, msg){
+    settingsDirty = Date.now();
+    return fetch("/settings", {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(body)})
+      .then(function(r){ return r.json().then(function(j){ if (!r.ok || !j.ok) throw new Error(j.msg || j.error || ("HTTP " + r.status)); return j; }); })
+      .then(function(){ toast(msg || "Saved"); setTimeout(refreshState, 1200); })
+      .catch(function(e){ toast("Couldn’t save: " + e.message, 4000); settingsDirty = 0; refreshState(); });
+  }
+  function renderIntervals(cur){
+    var box = $("intervalChips"); box.innerHTML = "";
+    var list = INTERVALS.slice();
+    if (cur && !list.some(function(x){ return x[0] === cur; })) list.push([cur, intervalLabel(cur)]), list.sort(function(a,b){ return a[0]-b[0]; });
+    list.forEach(function(x){
+      var b = document.createElement("button"); b.className = "chip" + (x[0] === cur ? " sel" : ""); b.textContent = x[1];
+      b.onclick = function(){
+        Array.prototype.forEach.call(box.children, function(c){ c.classList.remove("sel"); }); b.classList.add("sel");
+        saveSettings({interval:x[0]}, "New picture every " + x[1]);
+      };
+      box.appendChild(b);
+    });
+  }
+  (function fillHours(){
+    ["sleepStart","sleepEnd"].forEach(function(id){
+      var sel = $(id);
+      for (var h = 0; h < 24; h++) { var o = document.createElement("option"); o.value = h; o.textContent = hourName(h); sel.appendChild(o); }
+    });
+  })();
+  function parseSleep(list){
+    // Only the simple "* A-B[,C-D] * * *" form is editable here; anything else is left alone.
+    if (!list || !list.length) return {on:false, start:22, end:7, simple:true};
+    var m = list.length === 1 && /^\*\s+([\d,\-]+)\s+\*\s+\*\s+\*$/.exec(list[0].trim());
+    if (!m) return {on:true, simple:false};
+    var hours = {};
+    m[1].split(",").forEach(function(p){ var r = p.split("-").map(Number); for (var h = r[0]; h <= (r.length > 1 ? r[1] : r[0]); h++) hours[h] = 1; });
+    var start = -1;
+    for (var i = 0; i < 24; i++) if (hours[i] && !hours[(i + 23) % 24]) { start = i; break; }
+    if (start < 0) return {on:true, simple:false};
+    var end = start; while (hours[(end + 1) % 24] && (end + 1) % 24 !== start) end = (end + 1) % 24;
+    return {on:true, start:start, end:(end + 1) % 24, simple:true};
+  }
+  function sleepCron(start, end){
+    if (start === end) return null;
+    var r = start < end ? start + "-" + (end - 1) : (end === 0 ? start + "-23" : start + "-23,0-" + (end - 1));
+    r = r.replace(/(^|,)(\d+)-\2(?=,|$)/g, "$1$2");
+    return "* " + r + " * * *";
+  }
+  function saveSleep(){
+    if (!$("sleepOn").checked) { $("sleepHours").hidden = true; return saveSettings({quietHours:[]}, "Screen stays on all day"); }
+    $("sleepHours").hidden = false;
+    var a = +$("sleepStart").value, b = +$("sleepEnd").value, c = sleepCron(a, b);
+    if (!c) { toast("Pick two different times"); return; }
+    saveSettings({quietHours:[c]}, "Sleeps " + hourName(a) + "–" + hourName(b));
+  }
+  $("sleepOn").onchange = saveSleep; $("sleepStart").onchange = saveSleep; $("sleepEnd").onchange = saveSleep;
+  var phoneTz = ""; try { phoneTz = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch(e) {}
+  $("tzFix").onclick = function(){ saveSettings({timeZone:phoneTz}, "Time zone set to " + phoneTz); };
+  function renderSettings(cfg){
+    if (Date.now() - settingsDirty < 5000) return;
+    renderIntervals(cfg.intervalMinutes || 5);
+    var sl = parseSleep(cfg.quietHours);
+    $("sleepOn").checked = !!sl.on;
+    if (sl.simple && sl.on) { $("sleepStart").value = sl.start; $("sleepEnd").value = sl.end; }
+    else if (!sl.on) { $("sleepStart").value = 22; $("sleepEnd").value = 7; }
+    $("sleepHours").hidden = !sl.on || !sl.simple;
+    $("sleepSummary").textContent = sl.on ? (sl.simple ? "" : "custom schedule") : "";
+    var tz = cfg.timezone || "";
+    $("tzRow").hidden = !(phoneTz && tz !== phoneTz);
+    $("tzName").textContent = tz || "not set";
+    $("tzFix").textContent = "Use my phone’s time zone (" + phoneTz + ")";
+  }
+
+  // ---------- go ----------
+  refreshFiles().then(refreshState);
+  setInterval(refreshState, 15000);
+  document.addEventListener("visibilitychange", function(){ if (!document.hidden) { refreshFiles(); refreshState(); } });
+})();
+</script>
+</body>
+</html>
