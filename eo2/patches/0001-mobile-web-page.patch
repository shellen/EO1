+    for (i = 0; i < 4; i++) { far = Math.max(far, Math.sqrt(Math.pow(cs[i][0] - cx0, 2) + Math.pow(cs[i][1] - cy0, 2))); }
+    var N = 60, spacing = Math.max(12, far / ratio / (N - 2));
+    var flow = rng.rand(0.12, 0.25), lw = 5, wob = rng.rand(1.5, 3.5);
+
+    return function (t) {
+      var s = t * flow, base = Math.floor(s), frac = s - base;
+      var cx = cx0 + Math.sin(t * 0.05) * 10, cy = cy0 + Math.cos(t * 0.043) * 10, rot = rot0 + t * 0.01;
+      ctx.fillStyle = bg;
+      ctx.fillRect(0, 0, LW, LH);
+      ctx.lineWidth = lw;
+      for (i = 0; i < N; i++) {
+        var r = (i + frac) * spacing + Math.sin(i * 0.45 - t * 0.6) * wob;
+        if (r < 1) { continue; }
+        ctx.beginPath();
+        ctx.save();
+        ctx.translate(cx, cy);
+        ctx.rotate(rot);
+        ctx.scale(1, ratio);
+        ctx.moveTo(r, 0);
+        ctx.arc(0, 0, r, 0, TAU);
+        ctx.restore();
+        ctx.strokeStyle = cols[((i - base) % 4 + 4) % 4];
+        ctx.stroke();
+      }
+    };
+  }
+
+  /* ---------- stripes: scrolling 45 degree stripes behind a paper disc holding a dark disc ---------- */
+  function styleStripes(env) {
+    var ctx = env.ctx, rng = env.rng, P = env.pal5;
+    var bg = P[0], others = P.slice(1), i, dark = others[0];
+    for (i = 1; i < others.length; i++) {
+      if (Math.abs(lum(others[i]) - lum(bg)) > Math.abs(lum(dark) - lum(bg))) { dark = others[i]; }
+    }
+    var stripeCols = [];
+    for (i = 0; i < others.length && stripeCols.length < 3; i++) { if (others[i] !== dark) { stripeCols.push(rgbStr(others[i])); } }
+    var pitch = 45, sw = 22, dir = rng.rand(0, 1) < 0.5 ? 1 : -1, speed = rng.rand(3, 6);
+    var bigR = LW * rng.rand(0.3, 0.4), bx = LW * rng.rand(0.35, 0.65), by = LH * rng.rand(0.3, 0.7);
+    var smallR = bigR * rng.rand(0.32, 0.5), sa = rng.rand(0, TAU), so = (bigR - smallR) * rng.rand(0.2, 0.6);
+    var diag = Math.sqrt(LW * LW + LH * LH), bgS = rgbStr(bg), darkS = rgbStr(dark);
+
+    return function (t) {
+      var off = (t * speed) % (pitch * 3), k, n = Math.ceil(diag / pitch) + 4;
+      ctx.fillStyle = bgS;
+      ctx.fillRect(0, 0, LW, LH);
+      ctx.save();
+      ctx.translate(LW / 2, LH / 2);
+      ctx.rotate(dir * Math.PI / 4);
+      for (k = -n; k <= n; k++) {
+        ctx.fillStyle = stripeCols[((k % 3) + 3) % 3];
+        ctx.fillRect(k * pitch + off - sw / 2, -diag / 2, sw, diag);
+      }
+      ctx.restore();
+      var br = bigR * (1 + 0.02 * Math.sin(t * 0.3));
+      var cx = bx + Math.sin(t * 0.07) * 8, cy = by + Math.cos(t * 0.05) * 10;
+      ctx.beginPath();
+      ctx.arc(cx, cy, br, 0, TAU);
+      ctx.fillStyle = bgS;
+      ctx.fill();
+      var a = sa + t * 0.05;
+      ctx.beginPath();
+      ctx.arc(cx + Math.cos(a) * so, cy + Math.sin(a) * so, smallR * (1 + 0.04 * Math.sin(t * 0.5 + 1)), 0, TAU);
+      ctx.fillStyle = darkS;
+      ctx.fill();
+    };
+  }
+
+  /* ---------- registry ---------- */
+
+  var STYLES = [
+    { id: 'squares', name: 'Wandering Squares', make: styleSquares },
+    { id: 'pointillist', name: 'Pointillist Swirl', make: stylePointillist },
+    { id: 'pointillist2', name: 'Drifting Dots', make: stylePointillist2 },
+    { id: 'metricwave', name: 'Metric Wave', make: styleMetricwave },
+    { id: 'fabric', name: 'Breathing Fabric', make: styleFabric },
+    { id: 'cone', name: 'Light Cone', make: styleCone },
+    { id: 'surf', name: 'Surf', make: styleSurf },
+    { id: 'watercolor', name: 'Watercolor Wash', make: styleWatercolor },
+    { id: 'blocks', name: 'Bauhaus Blocks', make: styleBlocks },
+    { id: 'sunset', name: 'Striped Sunset', make: styleSunset },
+    { id: 'contours', name: 'Contour Rings', make: styleContours },
+    { id: 'stripes', name: 'Diagonal Stripes', make: styleStripes }
+  ];
+
+  window.ART_STYLES = [];
+  var byId = {}, si;
+  for (si = 0; si < STYLES.length; si++) {
+    window.ART_STYLES.push({ id: STYLES[si].id, name: STYLES[si].name });
+    byId[STYLES[si].id] = STYLES[si];
+  }
+
+  /* ---------- setup ---------- */
+
+  var seedParam = qs('seed'), styleParam = qs('style'), scaleParam = qs('scale');
+  var seed = (seedParam !== null && /^-?\d+$/.test(seedParam)) ? (parseInt(seedParam, 10) >>> 0) : Math.floor(Math.random() * 4294967296);
+  var style = byId[styleParam];
+  if (!style) {
+    // ?styles=a,b,c limits the random choice to those styles (unknown ids are ignored)
+    var pool = [], wanted = (qs('styles') || '').split(',');
+    for (var wi = 0; wi < wanted.length; wi++) { if (byId[wanted[wi]]) pool.push(byId[wanted[wi]]); }
+    if (!pool.length) pool = STYLES;
+    style = (seedParam !== null) ? pool[Math.floor(new Rng(seed ^ 0x5bd1e995).next() * pool.length)]
+      : pool[Math.floor(Math.random() * pool.length)];
+  }
+  var S = scaleParam === '1' ? 2 : 1;
+
+  var canvas = document.getElementById('art');
+  canvas.width = LW * S;
+  canvas.height = LH * S;
+  var ctx = canvas.getContext('2d');
+
+  function fit() {
+    var vw = window.innerWidth || document.documentElement.clientWidth;
+    var vh = window.innerHeight || document.documentElement.clientHeight;
+    var k = Math.max(vw / LW, vh / LH), w = Math.ceil(LW * k), h = Math.ceil(LH * k);
+    canvas.style.width = w + 'px';
+    canvas.style.height = h + 'px';
+    canvas.style.left = Math.floor((vw - w) / 2) + 'px';
+    canvas.style.top = Math.floor((vh - h) / 2) + 'px';
+  }
+  fit();
+  window.addEventListener('resize', fit, false);
+
+  var env = {
+    ctx: ctx, seed: seed,
+    rng: new Rng(seed),
+    data: makeInkData(new Rng(seed + 1)),
+    pal5: makePal5(new Rng(seed + 2))
+  };
+  var draw = style.make(env);
+
+  window.ART_CURRENT = { id: style.id, name: style.name, seed: seed };
+  window.ART_STATS = { frames: 0, totalMs: 0, maxMs: 0 };
+
+  var raf = window.requestAnimationFrame || window.webkitRequestAnimationFrame ||
+    function (cb) { return window.setTimeout(function () { cb(now()); }, 33); };
+
+  var startT = null, lastT = 0, FRAME_MS = 1000 / 30 - 2;
+
+  function tick() {
+    raf(tick);
+    var tnow = now();
+    if (startT === null) { startT = tnow; lastT = tnow - 1000 / 30; }
+    if (tnow - lastT < FRAME_MS) { return; }
+    var dt = Math.min(3, (tnow - lastT) / (1000 / 60));
+    lastT = tnow;
+    var t0 = now();
+    ctx.setTransform(S, 0, 0, S, 0, 0);
+    ctx.globalAlpha = 1;
+    draw((tnow - startT) / 1000, dt);
+    var ms = now() - t0;
+    window.ART_STATS.frames++;
+    window.ART_STATS.totalMs += ms;
+    if (ms > window.ART_STATS.maxMs) { window.ART_STATS.maxMs = ms; }
+  }
+  tick();
+})();
+</script>
+</body>
+</html>
