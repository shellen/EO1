diff --git a/app/src/main/resources/web/mobile.html b/app/src/main/resources/web/mobile.html
new file mode 100644
index 0000000..a1da434
--- /dev/null
+++ b/app/src/main/resources/web/mobile.html
@@ -0,0 +1,1672 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
+<meta name="apple-mobile-web-app-title" content="Frame">
+<meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)">
+<meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)">
+<link rel="apple-touch-icon" href="/icon.png">
+<link rel="icon" href="/icon.png">
+<title>Frame</title>
+<style>
+:root{
+  --bg:#f5f3ee;--ink:#161513;--muted:#77726a;--line:#d9d5cc;--fill:#eae6dd;
+  --accent:#d4472a;--good:#2f7d4f;--warn:#a8641c;--bad:#b3261e;
+  --serif:"Head",-apple-system,BlinkMacSystemFont,"Helvetica Neue",Helvetica,Arial,sans-serif;
+  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,monospace;
+  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
+}
+@media (prefers-color-scheme:dark){:root{
+  --bg:#0f0f0e;--ink:#efece5;--muted:#928c82;--line:#2b2926;--fill:#1b1a18;
+  --accent:#ff6a4a;--good:#6cc08b;--warn:#e3a35d;--bad:#e5534b;
+}}
+@font-face{font-family:"Head";src:url("/fonts/head-600.woff2") format("woff2");font-weight:600;font-display:swap}
+@font-face{font-family:"Head";src:url("/fonts/head-700.woff2") format("woff2");font-weight:700;font-display:swap}
+*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
+[hidden]{display:none!important}
+html,body{margin:0;background:var(--bg);color:var(--ink)}
+body{font:16px/1.4 var(--sans);max-width:640px;margin:0 auto;
+  padding:calc(env(safe-area-inset-top) + 14px) 18px calc(env(safe-area-inset-bottom) + 84px)}
+button{font:inherit;color:inherit;border:0;background:none;cursor:pointer;padding:0}
+a{color:inherit}
+
+/* type */
+.kicker,.sectionhead .count,.rowhead span,.qwhen,.info dt,.tabs button,.badge,.pill,.setlabel small,.xt small,.listrow small{
+  font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
+h1{font:700 36px/1.02 var(--serif);letter-spacing:-.03em;margin:6px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+h2{font:700 24px/1.1 var(--serif);letter-spacing:-.02em;margin:0}
+h3{font:600 17px/1.2 var(--sans);margin:0}
+
+/* masthead */
+header.mast{padding-bottom:14px;border-bottom:2px solid var(--ink);margin-bottom:18px}
+.kicker{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
+.dot{width:7px;height:7px;background:var(--muted);flex:none;display:inline-block}
+.dot.on{background:var(--good)}.dot.sleep{background:var(--warn)}.dot.off{background:var(--bad)}
+#sched:not(:empty):before{content:"· "}
+a.btn{text-decoration:none;display:inline-block}
+.offline{display:none;border:1px solid var(--bad);color:var(--bad);padding:10px 12px;font-size:14px;margin-bottom:14px}
+
+/* tabs */
+.tab{display:none}
+body[data-tab="now"] .tab[data-tab="now"],body[data-tab="library"] .tab[data-tab="library"],
+body[data-tab="extras"] .tab[data-tab="extras"],body[data-tab="frame"] .tab[data-tab="frame"],body.all .tab{display:block}
+body.all .tab{margin-bottom:34px}
+.tabs{position:fixed;left:0;right:0;bottom:0;z-index:8;background:var(--bg);border-top:1px solid var(--ink);
+  display:grid;grid-template-columns:repeat(4,1fr);max-width:640px;margin:0 auto;padding-bottom:env(safe-area-inset-bottom)}
+.tabs button{padding:16px 4px 15px;font-size:12px;color:var(--muted);border-top:3px solid transparent;margin-top:-2px}
+.tabs button.sel{color:var(--ink);border-top-color:var(--accent);font-weight:700}
+
+/* buttons */
+.btn,.primary{border:1px solid var(--ink);border-radius:6px;padding:11px 14px;font-weight:600;font-size:15px;text-align:center}
+.primary{background:var(--ink);color:var(--bg);width:100%;display:flex;align-items:center;justify-content:center;gap:8px}
+.primary svg{width:16px;height:16px}
+.primary[disabled],.btn[disabled]{opacity:.5}
+.btn:active,.primary:active,.chip:active{opacity:.7}
+.btn.small{padding:8px 12px;font-size:14px}
+.btn.go{background:var(--ink);color:var(--bg)}
+.btn.danger{border-color:var(--bad);color:var(--bad)}
+.sheet .btn.danger{background:var(--bad);color:#fff}
+.linkbtn{text-decoration:underline;font-size:14px;text-underline-offset:3px}
+.selbtn{font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;text-decoration:underline;text-underline-offset:3px}
+
+/* option groups */
+.seg{display:inline-flex;border:1px solid var(--ink);border-radius:6px;overflow:hidden}
+.seg button{padding:9px 12px;font-size:14px;color:var(--muted);border-left:1px solid var(--line)}
+.seg button:first-child{border-left:0}
+.seg button.sel{background:var(--ink);color:var(--bg)}
+.chips{display:flex;flex-wrap:wrap;gap:6px}
+.chip{border:1px solid var(--line);border-radius:6px;padding:8px 12px;font-size:14px}
+.chip.sel{background:var(--ink);color:var(--bg);border-color:var(--ink)}
+.switch{position:relative;width:46px;height:28px;flex:none;display:block}
+.switch input{opacity:0;width:0;height:0;position:absolute}
+.switch span{position:absolute;inset:0;border:1px solid var(--ink);border-radius:999px;transition:.15s}
+.switch span:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:var(--ink);border-radius:50%;transition:.15s}
+.switch input:checked+span{background:var(--ink)}
+.switch input:checked+span:before{transform:translateX(18px);background:var(--bg)}
+
+/* now */
+.nowpanel{display:flex;gap:16px;align-items:stretch}
+.nowpanel .thumb{width:118px;aspect-ratio:9/16;background:var(--fill) center/cover no-repeat;border:1px solid var(--ink);flex:none}
+.nowtext{min-width:0;flex:1;display:flex;flex-direction:column}
+.nowtext .name{font:700 26px/1.1 var(--serif);letter-spacing:-.02em;margin:6px 0 auto;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
+.nowbtns{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
+.nowbtns .btn.off{background:var(--ink);color:var(--bg)}
+.bright{display:flex;align-items:center;gap:12px;margin-top:16px;padding:12px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
+.bright .kicker{flex:none}
